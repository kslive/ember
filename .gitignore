# Downloaded model weights. Ember fetches its models at runtime into ~/Library, so
# none belong in the repo. Match file types and anchored paths only: a bare
# `models` pattern also matches Swift `Models/` source folders (core.ignorecase).
/models/
*.onnx
*.gguf
*.safetensors
*.mlmodelc/
*.mlpackage/
ggml-*.bin

